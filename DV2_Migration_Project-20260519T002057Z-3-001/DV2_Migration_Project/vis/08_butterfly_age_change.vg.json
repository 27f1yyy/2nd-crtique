{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 400,
  "data": {
    "url": "data/chart8_butterfly_age_comparison.csv",
    "format": { "type": "csv" }
  },
  "transform": [
    { "calculate": "toNumber(datum.left_2018_19)", "as": "left_2018_19" },
    { "calculate": "toNumber(datum.total_2024_25)", "as": "total_2024_25" },
    { "calculate": "toNumber(datum.age)", "as": "age" }
  ],
  "layer": [
    {
      "mark": { "type": "bar", "color": "#82c4d4" },
      "encoding": {
        "y": {
          "field": "age",
          "type": "ordinal",
          "title": "Age",
          "axis": { "labelFontSize": 10, "labelOverlap": true }
        },
        "x": {
          "field": "left_2018_19",
          "type": "quantitative",
          "title": "2018-19",
          "axis": {
            "format": "~s",
            "labelExpr": "abs(datum.value)"
          }
        },
        "tooltip": [
          { "field": "age", "type": "ordinal", "title": "Age" },
          { "field": "total_2018_19", "type": "quantitative", "title": "2018-19", "format": "," }
        ]
      }
    },
    {
      "mark": { "type": "bar", "color": "#245f73" },
      "encoding": {
        "y": { "field": "age", "type": "ordinal" },
        "x": {
          "field": "total_2024_25",
          "type": "quantitative",
          "title": "2024-25",
          "axis": { "format": "~s" }
        },
        "tooltip": [
          { "field": "age", "type": "ordinal", "title": "Age" },
          { "field": "total_2024_25", "type": "quantitative", "title": "2024-25", "format": "," }
        ]
      }
    }
  ],
  "resolve": { "scale": { "x": "shared" } }
}
