{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 320,
  "data": {
    "url": "data/chart4_top10_countries_grouped_bar.csv",
    "format": { "type": "csv" }
  },
  "transform": [
    {
      "calculate": "toNumber(datum.net_migration)",
      "as": "net_migration"
    }
  ],
  "mark": { "type": "bar" },
  "encoding": {
    "x": {
      "field": "Country",
      "type": "nominal",
      "title": null,
      "sort": { "field": "net_migration", "op": "sum", "order": "descending" },
      "axis": { "labelAngle": -35, "labelFontSize": 11 }
    },
    "xOffset": {
      "field": "year",
      "type": "nominal"
    },
    "y": {
      "field": "net_migration",
      "type": "quantitative",
      "title": "Net Migration",
      "axis": { "format": "," }
    },
    "color": {
      "field": "year",
      "type": "nominal",
      "title": "Year",
      "scale": {
        "domain": ["2018-19", "2024-25"],
        "range": ["#82c4d4", "#245f73"]
      }
    },
    "tooltip": [
      { "field": "Country", "type": "nominal", "title": "Country" },
      { "field": "year", "type": "nominal", "title": "Year" },
      { "field": "net_migration", "type": "quantitative", "title": "Net Migration", "format": "," }
    ]
  }
}