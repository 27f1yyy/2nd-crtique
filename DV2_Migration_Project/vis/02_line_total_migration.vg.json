{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 320,
  "data": {
    "url": "data/chart2_nom_trend_20yr.csv",
    "format": { "type": "csv" }
  },
  "layer": [
    {
      "mark": { "type": "line", "color": "#245f73", "strokeWidth": 2.5 },
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal",
          "title": null,
          "axis": { "labelAngle": -45, "labelFontSize": 11 }
        },
        "y": {
          "field": "net_overseas_migration",
          "type": "quantitative",
          "title": "Net Overseas Migration",
          "axis": { "format": "," }
        }
      }
    },
    {
      "mark": { "type": "point", "filled": true, "color": "#245f73", "size": 60 },
      "encoding": {
        "x": { "field": "year", "type": "ordinal" },
        "y": { "field": "net_overseas_migration", "type": "quantitative" },
        "tooltip": [
          { "field": "year", "type": "ordinal", "title": "Year" },
          { "field": "net_overseas_migration", "type": "quantitative", "title": "Net Migration", "format": "," }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "center",
        "dy": -15,
        "fontSize": 11,
        "fontWeight": "bold",
        "color": "#c0392b"
      },
      "encoding": {
        "x": { "field": "year", "type": "ordinal" },
        "y": { "field": "net_overseas_migration", "type": "quantitative" },
        "text": { "field": "year", "type": "ordinal" },
        "opacity": {
          "condition": {
            "test": "datum.year == '2020-21' || datum.year == '2022-23'",
            "value": 1
          },
          "value": 0
        }
      }
    }
  ]
}