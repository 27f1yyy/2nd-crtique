{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 320,
  "data": {
    "url": "data/chart5_world_regions_multiline.csv",
    "format": { "type": "csv" }
  },
  "transform": [
    { "calculate": "toNumber(datum.arrivals)", "as": "arrivals" }
  ],
  "mark": { "type": "line", "strokeWidth": 2 },
  "encoding": {
    "x": {
      "field": "year",
      "type": "ordinal",
      "title": null,
      "axis": { "labelAngle": -45, "labelFontSize": 10 }
    },
    "y": {
      "field": "arrivals",
      "type": "quantitative",
      "title": "Arrivals",
      "axis": { "format": "," }
    },
    "color": {
      "field": "region",
      "type": "nominal",
      "title": "Region"
    },
    "tooltip": [
      { "field": "year", "type": "ordinal", "title": "Year" },
      { "field": "region", "type": "nominal", "title": "Region" },
      { "field": "arrivals", "type": "quantitative", "title": "Arrivals", "format": "," }
    ]
  }
}